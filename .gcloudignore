# Files not uploaded by `gcloud run deploy --source .` (Cloud Build then applies .dockerignore).
# Never upload secrets or local persona data.
.gcloudignore
.git
.gitignore
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
data/
frontend/node_modules/
frontend/dist/
