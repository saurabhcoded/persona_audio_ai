# Copy to .env and adjust. Real environment variables override values here.

# --- App ---
APP_NAME="Fish Audio API"
APP_VERSION=0.1.0
# local | dev | staging | prod
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1

# --- Frontend ---
# Built React app served by FastAPI (prod). Ignored if missing.
FRONTEND_DIST_DIR=frontend/dist

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Secrets ---
SECRET_KEY=change-me
FISH_AUDIO_API_KEY=

# --- LLM: Gemini on Vertex AI (auth: `gcloud auth application-default login`, no key) ---
# Empty = use the gcloud/ADC default project
GCP_PROJECT=
GCP_LOCATION=global
LLM_CHAT_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high (gemini-4-argon rejects minimal). minimal: same style, steadier latency
LLM_CHAT_THINKING=minimal
LLM_CHAT_TEMPERATURE=0.9
# Chat model when location assist tools are on (needs reliable function calling)
LLM_TOOLS_MODEL=gemini-3.5-flash
LLM_BUILD_MODEL=gemini-4-argon
LLM_CLASSIFY_MODEL=gemini-3.5-flash-lite
CHAT_MAX_HISTORY=20

# --- Personas ---
# Sanitized persona data lives here (git-ignored). Raw chat exports are never written.
DATA_DIR=data
UPLOAD_MAX_MB=25
PERSONA_MIN_MESSAGES=30
# Most recent reply pairs embedded per persona (build time grows with this)
PERSONA_MAX_PAIRS=3000
# gemini-embedding-2 takes one text per call, so calls run in parallel
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
EMBEDDING_CONCURRENCY=16
RETRIEVAL_PAIRS_K=12

# --- Fish Audio TTS ---
FISH_TTS_MODEL=s2.1-pro
# mp3 | wav | opus
FISH_TTS_FORMAT=mp3
# Empty = Fish default voice
FISH_DEFAULT_VOICE_ID=
TTS_MAX_CHARS=1000
# Parallel TTS calls per streamed reply (Fish rejects ~6 concurrent requests)
TTS_STREAM_CONCURRENCY=2

# --- Location assist (Google Places API (New) + Routes API) ---
LOCATION_ASSIST=true
# Empty = use gcloud ADC (APIs must be enabled on the project: places.googleapis.com, routes.googleapis.com)
GOOGLE_MAPS_API_KEY=
LOCATION_REGION=in
# Search bias: centre + radius (default New Delhi, 50 km)
LOCATION_BIAS_LAT=28.6139
LOCATION_BIAS_LNG=77.2090
LOCATION_BIAS_RADIUS_M=50000
# Cities checked for ambiguous areas like "Sector 15" (JSON list)
LOCATION_CITIES=["New Delhi","Noida","Gurugram","Faridabad","Ghaziabad"]
